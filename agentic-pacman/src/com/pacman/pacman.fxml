<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.pacman.GameController"
            fx:id="root"
            prefWidth="560.0" prefHeight="668.0"
            style="-fx-background-color: black;">

    <children>
        <Canvas fx:id="canvas" width="560.0" height="668.0"/>

        <VBox fx:id="menu" alignment="CENTER" spacing="16.0"
              AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
              style="-fx-background-color: rgba(0,0,0,0.84);">
            <children>
                <Label text="PAC-MAN" textFill="#FFE100">
                    <font><Font name="Monospaced" size="46.0"/></font>
                </Label>

                <Label fx:id="statusLabel" text="" textFill="#8AE234">
                    <font><Font name="Monospaced" size="16.0"/></font>
                </Label>

                <Label text="CHOOSE YOUR OPPONENT" textFill="#FFFFFF">
                    <font><Font name="Monospaced" size="15.0"/></font>
                </Label>

                <RadioButton fx:id="soloGhost" text="1 Ghost  -  HUNTER  (hard, calculated)"
                             textFill="#FF3B3B"
                             style="-fx-font-family: Monospaced; -fx-font-size: 14px;">
                    <toggleGroup>
                        <ToggleGroup fx:id="ghostGroup"/>
                    </toggleGroup>
                </RadioButton>

                <RadioButton fx:id="allGhosts" text="4 Ghosts  -  CLASSIC  (Blinky, Pinky, Inky, Clyde)"
                             textFill="#00E5FF" selected="true" toggleGroup="$ghostGroup"
                             style="-fx-font-family: Monospaced; -fx-font-size: 14px;"/>

                <Button fx:id="startButton" text="START" onAction="#onStart"
                        style="-fx-font-family: Monospaced; -fx-font-size: 16px; -fx-font-weight: bold;"/>

                <Label text="ARROWS / WASD  MOVE     P  PAUSE     M  SOUND     G  GRAPH"
                       textFill="#AAAAAA">
                    <font><Font name="Monospaced" size="12.0"/></font>
                </Label>

                <Label text="secret codes:  speedup   freeze   godmode" textFill="#666666">
                    <font><Font name="Monospaced" size="11.0"/></font>
                </Label>
            </children>
        </VBox>
    </children>
</AnchorPane>
