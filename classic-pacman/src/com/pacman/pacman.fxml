<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.pacman.GameController"
           fx:id="rootPane"
           style="-fx-background-color: black;"
           prefWidth="560.0" prefHeight="668.0">

    <children>
        <AnchorPane fx:id="gameContainer"
                    prefWidth="560.0" prefHeight="668.0"
                    maxWidth="560.0" maxHeight="668.0"
                    style="-fx-background-color: black;">

            <children>
                <Canvas fx:id="canvas" width="560.0" height="668.0"/>

                <!-- MAIN GAME MENU -->
                <VBox fx:id="menu" alignment="CENTER" spacing="16.0"
                      AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                      AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
                      style="-fx-background-color: rgba(0,0,0,0.92);"
                      visible="false" managed="false">
                    <children>
                        <Label text="PAC-MAN" textFill="#FFE100">
                            <font><Font name="Monospaced" size="46.0"/></font>
                            <effect><DropShadow color="#FFE100" radius="15.0" spread="0.4"/></effect>
                        </Label>

                        <Label fx:id="statusLabel" text="" textFill="#8AE234">
                            <font><Font name="Monospaced" size="16.0"/></font>
                        </Label>

                        <Label text="CLASSIC ARCADE MODE" textFill="#FFFFFF">
                            <font><Font name="Monospaced" size="15.0"/></font>
                        </Label>

                        <RadioButton fx:id="allGhosts" text="4 Ghosts  -  CLASSIC  (Blinky, Pinky, Inky, Clyde)"
                                     textFill="#00E5FF" selected="true"
                                     style="-fx-font-family: Monospaced; -fx-font-size: 14px;"/>

                        <Button fx:id="startButton" text="START" onAction="#onStart"
                                style="-fx-font-family: Monospaced; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-color: #FFE100; -fx-text-fill: black; -fx-cursor: hand;"/>

                        <Label text="ARROWS / WASD  MOVE     P  PAUSE     M  SOUND"
                               textFill="#AAAAAA">
                            <font><Font name="Monospaced" size="12.0"/></font>
                        </Label>
                    </children>
                </VBox>

                <!-- EXIT CONFIRMATION DIALOG -->
                <VBox fx:id="exitDialog" alignment="CENTER" spacing="18.0"
                      AnchorPane.topAnchor="240.0" AnchorPane.leftAnchor="120.0" AnchorPane.rightAnchor="120.0"
                      style="-fx-background-color: rgba(10,10,25,0.95); -fx-border-color: #2121DE; -fx-border-width: 2.5px; -fx-padding: 22px; -fx-background-radius: 8px;"
                      visible="false" managed="false">
                    <children>
                        <Label text="ARE YOU SURE?" textFill="#FFE100">
                            <font><Font name="Monospaced" size="18.0"/></font>
                        </Label>
                        <HBox alignment="CENTER" spacing="25.0">
                            <children>
                                <Button text="YES" onAction="#onExitYes"
                                        style="-fx-font-family: Monospaced; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-color: #FF3B3B; -fx-text-fill: white; -fx-cursor: hand; -fx-pref-width: 70px;"/>
                                <Button text="NO" onAction="#onExitNo"
                                        style="-fx-font-family: Monospaced; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-color: #8AE234; -fx-text-fill: black; -fx-cursor: hand; -fx-pref-width: 70px;"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <!-- HIGH-END ARCADE INTRO & LOADING OVERLAY -->
                <VBox fx:id="introOverlay" alignment="CENTER" spacing="22.0"
                      AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                      AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
                      style="-fx-background-image: url('/com/pacman/arcade_bg.jpg');
                             -fx-background-size: cover;
                             -fx-background-position: center;
                             -fx-background-color: rgba(5, 5, 12, 0.90);">
                    <children>
                        <Label fx:id="arcadeHeaderLabel" text="WELCOME TO PAC-MAN!" textFill="#FFE100">
                            <font><Font name="Monospaced" size="30.0"/></font>
                            <effect><DropShadow color="#000000" radius="10.0" spread="0.8"/></effect>
                        </Label>

                        <HBox fx:id="characterBox" alignment="CENTER" spacing="16.0" opacity="0.0"
                              style="-fx-padding: 12px; -fx-background-color: rgba(10,10,20,0.85); -fx-background-radius: 8px; -fx-border-color: #2121DE; -fx-border-radius: 8px;">
                            <children>
                                <Label text="ᗧ" textFill="#FFE100"><font><Font name="Monospaced" size="26.0"/></font></Label>
                                <Label text="BLINKY" textFill="#FF3B3B"><font><Font name="Monospaced" size="13.0"/></font></Label>
                                <Label text="PINKY" textFill="#FFB8FF"><font><Font name="Monospaced" size="13.0"/></font></Label>
                                <Label text="INKY" textFill="#00E5FF"><font><Font name="Monospaced" size="13.0"/></font></Label>
                                <Label text="CLYDE" textFill="#FFB852"><font><Font name="Monospaced" size="13.0"/></font></Label>
                            </children>
                        </HBox>

                        <Label fx:id="loadingTextLabel" text="INITIALIZING RETRO ARCADE CABINET..." textFill="#00E5FF">
                            <font><Font name="Monospaced" size="13.0"/></font>
                            <effect><DropShadow color="#000000" radius="5.0"/></effect>
                        </Label>

                        <ProgressBar fx:id="loadingProgressBar" progress="0.0" prefWidth="320.0" prefHeight="16.0"
                                     style="-fx-accent: #00E5FF; -fx-control-inner-background: #111122; -fx-box-border: #2121DE;"/>

                        <Label fx:id="percentageLabel" text="0%" textFill="#FFE100">
                            <font><Font name="Monospaced" size="16.0"/></font>
                            <effect><DropShadow color="#000000" radius="5.0"/></effect>
                        </Label>
                    </children>
                </VBox>
            </children>
        </AnchorPane>
    </children>
</StackPane>